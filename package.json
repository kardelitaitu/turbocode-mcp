{
  "name": "turbocode-mcp",
  "version": "1.0.0",
  "description": "Local codebase vector search MCP server powered by Turbovec — fully local, no cloud, no API keys",
  "main": "bin/cli.js",
  "bin": {
    "turbocode-mcp": "./bin/cli.js"
  },
  "scripts": {
    "postinstall": "node ./scripts/setup.js",
    "test": "npm run test:py && npm run test:js",
    "test:all": "npm run test:py && npm run test:js && npm run test:integration",
    "test:py": ".venv\\Scripts\\python.exe -m pytest tests/test_server.py tests/test_regressions.py -q",
    "test:js": "node --test test\\cli.test.js test\\setup.test.js test\\runtime.test.js",
    "test:integration": ".venv\\Scripts\\python.exe -m pytest tests/test_integration.py -v"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "turbovec",
    "rag",
    "codebase",
    "vector-search",
    "semantic-search",
    "local-ai"
  ],
  "author": "",
  "license": "MIT"
}
